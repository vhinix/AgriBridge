# Application
APP_NAME=AgriBridge
APP_VERSION=1.0.0
ENVIRONMENT=development

# Supabase
# Vite only exposes vars prefixed with VITE_ to client code — the app cannot
# read anything without the prefix.
#
# Use the anon (publishable) key from Supabase → Project Settings → API.
# Never put the service_role key here: it bypasses row level security and this
# app ships its env to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
